# Bookr Business App - Environment Variables
# Copy this file to .env and fill in the values. NEVER COMMIT .env!

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# External Services
RAZORPAY_KEY_ID=your_razorpay_test_key
SENTRY_DSN=your_sentry_dsn
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# SMTP Services
RESEND_API=your_resent_api_key

# Whatsapp services
AISENSY_API_KEY=your_aisensy_api_key

STALLION_API_KEY=your_actual_key_here